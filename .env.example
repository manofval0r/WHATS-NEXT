# ==============================================================
# WHATS-NEXT — environment template
#
#   cp .env.example .env      # then fill in the blanks
#
# Every variable below is read by whats_next_backend/settings.py.
# Nothing in this file is a real credential.
# ==============================================================

# ---------------------------------------------------------
# Django
# ---------------------------------------------------------
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-generate-a-fresh-random-key

# Must be "false" in production. Defaults to false when unset.
DEBUG=false

# Comma-separated. Include your Render hostname and local dev hosts.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public URL of the deployed frontend. Used to build links in
# emails, share links and OAuth redirects. Required in production.
FRONTEND_URL=http://localhost:5173

# Production database URL. On Render this is injected automatically
# when a Postgres instance is attached.
#   postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/whats_next

# ---------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------
# Without this the app falls back to a per-process local-memory
# cache, which silently breaks the roadmap generation lock under
# more than one worker. Set it in production.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# Where email is sent from.
DEFAULT_FROM_EMAIL=WHATS-NEXT <no-reply@example.com>

# console  -> prints to stdout (development)
# smtp     -> real SMTP (production); see SMTP_* below
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------------------------------------------------------
# AI providers
# ---------------------------------------------------------
# Google Gemini — roadmap, lessons, quizzes, chat.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — optional. Adds a model cascade in front of Gemini.
# If set, the model IDs in core/openrouter_client.py must exist in
# the live catalogue at https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=WHATS-NEXT

# ---------------------------------------------------------
# External data APIs
# ---------------------------------------------------------
# YouTube Data API v3 — resource search. Default quota is 10,000
# units/day; the app spends ~100 units per module per cold cache fill.
YOUTUBE_API_KEY=

# GitHub REST API — raises project scoring from 60 req/hr unauthenticated
# to 5,000 req/hr. Strongly recommended.
# https://github.com/settings/tokens  (no scopes needed for public repos)
GITHUB_TOKEN=

# ---------------------------------------------------------
# Social auth (django-allauth) — both providers are optional.
# ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------
# Analytics
# ---------------------------------------------------------
# PostHog server-side capture. Leave blank to disable.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------
# Misc
# ---------------------------------------------------------
# Used for the README example URL.
SITE_URL=http://localhost:8000

# ==============================================================
# FRONTEND — frontend/.env.local
# ==============================================================
# VITE_API_URL=http://127.0.0.1:8000
# VITE_POSTHOG_KEY=<project api key, publishable only>